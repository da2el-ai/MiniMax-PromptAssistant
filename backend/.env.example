# llama-server(OpenAI 互換 API)の設定例
# 実際に使う値は環境変数として渡す(このファイルはコミット用のサンプル)

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_SEC=300

LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=4096

# 構造化出力の指定方法: json_schema / json_object / none
LLM_RESPONSE_FORMAT=json_schema

# 思考モード(reasoning_content)を無効化する。
# 有効なままだと思考だけで max_tokens を使い切り、本文が空で返ることがある
LLM_DISABLE_THINKING=true

# 検証 NG 時の再生成回数の上限
GENERATE_MAX_RETRIES=3

# CORS 許可オリジン(カンマ区切り)
# 通常の起動(serve.py)では画面と API が同じオリジンになるため、この設定は使われない。
# フロントエンドを別オリジンから配信する場合にのみ設定する
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
